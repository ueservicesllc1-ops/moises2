# Stripe client/public key (safe to expose in browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe server secret key (never expose client-side)
STRIPE_SECRET_KEY=
# One secret or multiple secrets separated by commas
STRIPE_WEBHOOK_SECRET=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Stripe recurring price IDs
STRIPE_PRICE_LITE_MONTHLY=
STRIPE_PRICE_LITE_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# Optional: hosted checkout links (legacy fallback)
NEXT_PUBLIC_CHECKOUT_LITE_MONTHLY=
NEXT_PUBLIC_CHECKOUT_LITE_YEARLY=
NEXT_PUBLIC_CHECKOUT_PRO_MONTHLY=
NEXT_PUBLIC_CHECKOUT_PRO_YEARLY=

# Desarrollo: si la red local no llega a Backblaze, usa el despliegue Next en Railway como proxy de audio.
# URL base HTTPS sin barra final (ej. https://tu-app.up.railway.app). En localhost el audio B2 irá a
# `${NEXT_PUBLIC_REMOTE_AUDIO_PROXY}/api/download?url=…` (no usa localhost:3001 ni B2 directo).
NEXT_PUBLIC_REMOTE_AUDIO_PROXY=
